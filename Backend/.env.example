# ── Copy this file to .env and fill in your values ────────────────────────────
# cp .env.example .env

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saraswati

# JWT — generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here
EMBED_MODEL=mistral-embed
LLM_MODEL=mistral-large-latest

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=saraswati_docs

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# RAG tuning
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_CHUNKS=5

# CORS (comma-separated origins)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
